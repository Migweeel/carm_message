# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:Mm12345678@localhost:5432/carmel_communion?schema=public"

# Use a long, random value in real deployments
JWT_SECRET="replace-with-a-long-random-secret"

# Local dashboard preview only; ignored in production mode
DEMO_AUTH_ENABLED=true
DEMO_ADMIN_EMAIL="admin@carmel.test"
DEMO_ADMIN_PASSWORD="12345678"

# Seed creates the initial ADMIN account only when both are set
ADMIN_NAME="Federation Administrator"
ADMIN_EMAIL="admin@example.org"
ADMIN_PASSWORD="replace-with-a-strong-password"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"
LIGHTFM_SERVICE_URL="http://127.0.0.1:8001"
LIGHTFM_API_TOKEN="set-the-same-random-token-in-recommender/.env"

# Resend settings required to deliver password-reset and completed-donation acknowledgment emails
RESEND_API_KEY=""
RESEND_FROM="Carmels in Communion <receipts@your-verified-domain.example>"
